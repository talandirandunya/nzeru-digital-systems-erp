# Copy these to Railway service variables.
# Railway PostgreSQL provides DATABASE_URL automatically when PostgreSQL is linked
# to the web service with a reference variable: ${{Postgres.DATABASE_URL}}

# Required - set manually in Railway Variables
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=nzeru-digital-systems-erp-production.up.railway.app
CSRF_TRUSTED_ORIGINS=https://nzeru-digital-systems-erp-production.up.railway.app
DJANGO_SETTINGS_MODULE=management_system.settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Add a Railway PostgreSQL service, then add this variable to the web service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Email (required for password reset and notifications)
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=your-email@yourdomain.com
CURRENCY_CODE=MWK
CURRENCY_SYMBOL=MK
CURRENCY_NAME=Malawian Kwacha
# SMTP alternative: set EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER,
# EMAIL_HOST_PASSWORD, and DEFAULT_FROM_EMAIL instead of RESEND_API_KEY.
