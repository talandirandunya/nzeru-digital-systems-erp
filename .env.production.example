# Copy to `.env` on the VPS (same directory as docker-compose.prod.yml) and fill in every value.
# `.env` is git-ignored — never commit real secrets.

# --- Django ---
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DJANGO_SETTINGS_MODULE=management_system.settings
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Database (Postgres container credentials, and the Django connection string) ---
POSTGRES_DB=zentral
POSTGRES_USER=zentral_user
POSTGRES_PASSWORD=zentral_dev_2026
# Must reference the same values as above — the "db" host name is the compose service name.
DATABASE_URL=postgresql://zentral_user:zentral_dev_2026@db:5432/zentral
# The Postgres container has no TLS certificate and rejects sslmode=require. The
# connection never leaves the private compose network, so plain is correct here.
# Set to True only if you point DATABASE_URL at a managed database instead.
DB_SSL_REQUIRE=False

# --- Email (required when DEBUG=False) ---
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

# --- Media storage (optional) ---
# Leave blank to persist uploaded files on the VPS's docker volume (served by nginx).
# Fill in to use Cloudinary instead (recommended if you'll ever redeploy/rebuild the volume away).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
